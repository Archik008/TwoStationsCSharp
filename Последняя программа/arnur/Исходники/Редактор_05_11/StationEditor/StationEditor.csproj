<Project Sdk="Microsoft.NET.Sdk">

  <!-- Редактор станций (C#-версия веб-макета «Исходники\Редактор станций»). Схема сохраняется в .station.json -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <AssemblyName>StationEditor</AssemblyName>
    <RootNamespace>StationEditor</RootNamespace>
    <ApplicationHighDpiMode>SystemAware</ApplicationHighDpiMode>
    <Product>Редактор станций</Product>
    <Version>0.3.0</Version>
  </PropertyGroup>

  <!-- [ДОБАВЛЕНО 23.11.2026] языки интерфейса ru / kk / en — общие файлы перевода Алгабаса (ссылками, не копиями);
       словари собираются из Инструменты\i18n\strings.tsv (check.py, ключ build) -->
  <ItemGroup>
    <Compile Include="..\..\Алгабас\Algabas\Core\Lang.cs" Link="Shared\Lang.cs" />
    <Compile Include="..\..\Алгабас\Algabas\Ui\LangUi.cs" Link="Shared\LangUi.cs" />
    <EmbeddedResource Include="..\..\Алгабас\Algabas\Lang\Strings.kk.json" Link="Lang\Strings.kk.json" LogicalName="Strings.kk.json" WithCulture="false" />
    <EmbeddedResource Include="..\..\Алгабас\Algabas\Lang\Strings.en.json" Link="Lang\Strings.en.json" LogicalName="Strings.en.json" WithCulture="false" />
  </ItemGroup>

</Project>
