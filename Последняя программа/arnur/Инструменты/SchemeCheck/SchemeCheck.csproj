<Project Sdk="Microsoft.NET.Sdk">
  <!-- [ДОБАВЛЕНО 18.11.2026] проверка «Станции по схеме» без окна: каждую схему .station.json строит как программа,
       задаёт по очереди каждый маршрут и смотрит: задался ли, открылся ли светофор, ведут ли стрелки туда, куда маршрут.
       dotnet run [файлы.station.json]   без файлов — все схемы из папок «Станции» -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <RootNamespace>StationApp</RootNamespace>
    <NoWarn>$(NoWarn);CS8632;CS0108;CS0162;CS0169;CS0414;CS0649</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="System.IO.Ports" Version="8.0.0" />
  </ItemGroup>
  <ItemGroup>
    <Compile Include="..\..\Исходники\Алгабас\Algabas\Core\*.cs" Link="Shared\Core\%(Filename)%(Extension)" />
    <Compile Include="..\..\Исходники\Алгабас\Algabas\Ui\*.cs" Link="Shared\Ui\%(Filename)%(Extension)" />
    <Compile Include="..\..\Исходники\Алгабас\Algabas\Ai\*.cs" Exclude="..\..\Исходники\Алгабас\Algabas\Ai\AiProfile.cs" Link="Shared\Ai\%(Filename)%(Extension)" />
    <Compile Include="..\..\Исходники\Редактор_05_11\StationEditor\Model\*.cs" Link="Editor\%(Filename)%(Extension)" />
    <Compile Include="..\..\Исходники\Станция по схеме\StationFromJson\**\*.cs" Exclude="..\..\Исходники\Станция по схеме\StationFromJson\Program.cs;..\..\Исходники\Станция по схеме\StationFromJson\obj\**;..\..\Исходники\Станция по схеме\StationFromJson\bin\**" Link="Scheme\%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>
</Project>
