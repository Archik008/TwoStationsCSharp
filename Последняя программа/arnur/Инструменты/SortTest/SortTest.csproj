<Project Sdk="Microsoft.NET.Sdk">
  <!-- [ДОБАВЛЕНО 12.11.2026] проверка модели горки «Сортировочной» без окна: dotnet run -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <DefineConstants>$(DefineConstants);SORTTEST</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="..\..\Исходники\Сортировочная\Sortirovka\Yard\*.cs" Link="Yard\%(Filename)%(Extension)" />
  </ItemGroup>
</Project>
